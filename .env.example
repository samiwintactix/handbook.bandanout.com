PORT=3000

ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=generate-at-id.atlassian.com/manage-profile/security/api-tokens

JIRA_SITE=https://wintactix-sandbox.atlassian.net

CONFLUENCE_SITE=https://wintactix-com.atlassian.net
CONFLUENCE_PAGE_ID=56524801
CONFLUENCE_SPACE_KEY=CHE

# Shared secret the Slack bot sends as the X-Bandanout-Token header when
# posting to POST /api/signals/slack. Generate any long random string.
SLACK_SIGNAL_TOKEN=

# "Sign in with Atlassian" — register a separate OAuth 2.0 (3LO) app at
# https://developer.atlassian.com/console/myapps/ (Account-level access,
# User identity API with the read:me scope, callback URL pointing at
# <your-domain>/auth/callback). Leave these unset locally to skip sign-in
# during development.
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://handbook.bandanout.com/auth/callback
ALLOWED_EMAIL_DOMAIN=wintactix.com
